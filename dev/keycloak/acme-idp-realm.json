{
  "realm": "acme-idp",
  "displayName": "ACME Example IdP",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "example-user",
        "description": "Local development role for ACME IdP token tests"
      },
      {
        "name": "documents:read:document-42",
        "description": "PIC lab authority to read the sensitive document"
      },
      {
        "name": "storage:save",
        "description": "PIC lab authority to store the processed result"
      }
    ]
  },
  "clients": [
    {
      "clientId": "acme-idp-client",
      "name": "ACME IdP local token client",
      "description": "Confidential local client with direct access grants enabled for password-based token generation.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "acme-idp-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "pic-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "pic_scopes",
            "claim.name": "pic_scopes",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.local",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "attributes": {
        "pic_scopes": [
          "documents:read:document-42",
          "storage:save"
        ]
      },
      "realmRoles": [
        "example-user",
        "documents:read:document-42",
        "storage:save"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}
