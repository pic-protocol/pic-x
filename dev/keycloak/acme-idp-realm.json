{
  "realm": "acme-idp",
  "displayName": "ACME Example IdP",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "example-user",
        "description": "Local development role for ACME IdP token tests"
      }
    ]
  },
  "clients": [
    {
      "clientId": "acme-idp-client",
      "name": "ACME IdP local token client",
      "description": "Confidential local client with direct access grants enabled for password-based token generation.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "acme-idp-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.local",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": [
        "example-user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}
